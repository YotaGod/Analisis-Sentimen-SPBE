n    \n    print(\"\\nCONFUSION MATRIX:\")\n    cm = confusion_matrix(y_test, all_preds)\n    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", xticklabels=[\"Negatif\", \"Positif\"], yticklabels=[\"Negatif\", \"Positif\"])\n    plt.xlabel(\"Predicted Label\")\n    plt.ylabel(\"True Label\")\n    plt.title(\"Confusion Matrix IndoBERT\")\n    plt.show()\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-16T15:07:50.39091Z","iopub.execute_input":"2026-08-16T15:07:50.391658Z","iopub.status.idle":"2026-08-16T15:08:08.625385Z","shell.execute_reply.started":"2026-08-16T15:07:50.391628Z","shell.execute_reply":"2026-08-16T15:08:08.624704Z"}},"outputs":[{"name":"stdout","text":"\n📊 OVERALL ACCURACY INDOBERT: 87.28%\n\nCLASSIFICATION REPORT:\n              precision    recall  f1-score   support\n\n     Negatif       0.91      0.82      0.86      1093\n     Positif       0.84      0.92      0.88      1148\n\n    accuracy                           0.87      2241\n   macro avg       0.88      0.87      0.87      2241\nweighted avg       0.88      0.87      0.87      2241\n\n\nCONFUSION MATRIX:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":7},{"cell_type":"markdown","source":"---\n## 🚀 TAHAP 4.7: Deploy Inference & Export untuk Dashboard Streamlit\n**Sesuai Skripsi Subbab 4.7:**  \nMembuat fungsi inferensi *real-time* ulasan baru dan menyiapkan model tersimpan untuk Dashboard Streamlit.\n\n","metadata":{}},{"cell_type":"code","source":"def predict_sentiment_single(text: str, model=model, tokenizer=tokenizer):\n    text_clean = preprocess_text_skripsi(text).replace(\"_\", \" \")\n    asp, conf_asp = classify_aspect(text_clean)\n    \n    inputs = tokenizer(text_clean, truncation=True, padding=\"max_length\", max_length=128, return_tensors=\"pt\").to(device)\n    with torch.no_grad():\n        outputs = model(**inputs)\n        probs = torch.softmax(outputs.logits, dim=1).squeeze(0)\n        pred_idx = torch.argmax(probs).item()\n        confidence = probs[pred_idx].item()\n        \n    label = \"Positif\" if pred_idx == 1 else \"Negatif\"\n    return label, round(float(confidence), 4), asp, round(float(conf_asp), 4)\n\n# Uji Coba Inferensi Real-Time\nsample_test_input = \"Aplikasi JAKI sangat membantu warga Jakarta, fitur laporan banjir cepat ditanggapi petugas!\"\nsent, conf_s, asp, conf_a = predict_sentiment_single(sample_test_input)\n\nprint(\"Teks Ulasan  :\", sample_test_input)\nprint(\"Hasil Sentimen:\", sent, f\"({conf_s*100:.1f}%)\")\nprint(\"Hasil Aspek   :\", asp, f\"({conf_a*100:.1f}%)\")\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-16T15:08:08.62641Z","iopub.execute_input":"2026-08-16T15:08:08.626828Z","iopub.status.idle":"2026-08-16T15:08:08.65393Z","shell.execute_reply.started":"2026-08-16T15:08:08.6268Z","shell.execute_reply":"2026-08-16T15:08:08.653196Z"}},"outputs":[{"name":"stdout","text":"Teks Ulasan  : Aplikasi JAKI sangat membantu warga Jakarta, fitur laporan banjir cepat ditanggapi petugas!\nHasil Sentimen: Positif (99.8%)\nHasil Aspek   : Fungsionalitas (50.0%)\n","output_type":"stream"}],"execution_count":8}]}